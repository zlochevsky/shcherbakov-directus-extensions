        "id": "75ba7708-cc8e-4889-8944-2fb5c421a2d5",
        "key": "set_id_number",
        "name": "Run Script",
        "options": {
          "code": "module.exports = async function(data) {\n  const payload = data.$trigger.payload;\n  const key = (v) => (v && typeof v === 'object') ? v.id : v;\n  if (!payload.num) {\n    const ex = data.existing;\n    const max = (ex && ex.length) ? (Number(ex[0].num) || 0) : 0;\n    payload.num = max + 1;\n  }\n  if (!payload.id && payload.sets_id && payload.perfs_id) {\n    const numStr = String(payload.num).padStart(3, '0');\n    payload.id = `${key(payload.sets_id)}_${numStr}_${key(payload.perfs_id)}`;\n  }\n  return payload;\n};"
        },
        "position_x": "37",
        "position_y": "1",
        "reject": null,
        "resolve": null,
        "type": "exec",
        "user_created": "f8f3600f-6504-4e7f-b3d2-5a25fb4ba3a0"
      }
