    "date_created": "2026-08-14T15:54:52.000Z",
    "description": "Заполняет поля year и dw при сохранении события, если в этом событии также задана точная его дата.",
    "icon": "bolt",
    "id": "88e29238-c27e-45b3-93c4-c6172e9a2db3",
    "name": "Auto year and dw",
    "operation": "72935641-d711-4cc3-9e68-97ff8b7288ed",
    "operations": [
      {
        "date_created": "2026-08-14T15:56:08.000Z",
        "flow": "88e29238-c27e-45b3-93c4-c6172e9a2db3",
        "id": "72935641-d711-4cc3-9e68-97ff8b7288ed",
        "key": "exec_djxop",
        "name": "Run Script",
        "options": {
          "code": "module.exports = async function(data) {\n  const payload = data.$trigger.payload;\n  if (payload.date) {\n    const d = new Date(payload.date);\n    const days = [\"вс\", \"пн\", \"вт\", \"ср\", \"чт\", \"пт\", \"сб\"];\n    payload.year = d.getUTCFullYear();\n    payload.dw = days[d.getUTCDay()];\n  }\n  return payload;\n};"
        },
        "position_x": "19",
        "position_y": "1",
        "reject": null,
        "resolve": null,
        "type": "exec",
        "user_created": "a3f49b86-1314-45c2-a8c4-0e7d321b9d0a"
      }
