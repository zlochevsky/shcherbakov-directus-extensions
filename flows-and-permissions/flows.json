    "description": "Если id не введён вручную и есть date — подставляет L<YYYY-MM-DD>",
    "icon": "event",
    "id": "1a42f664-5cc5-42f5-b1c3-0d6794ba5aca",
    "name": "Auto event id",
    "operation": "0723c1c0-4345-4445-8775-bf2e502586ad",
    "operations": [
      {
        "date_created": "2026-09-11T16:18:30.685Z",
        "flow": "1a42f664-5cc5-42f5-b1c3-0d6794ba5aca",
        "id": "0723c1c0-4345-4445-8775-bf2e502586ad",
        "key": "set_id",
        "name": "Run Script",
        "options": {
          "code": "module.exports = async function(data) {\n  const payload = data.$trigger.payload;\n  if (!payload.id && payload.date) {\n    let id = `L${payload.date.slice(0, 10)}`;\n    if (payload.day_evening === 'дневной') {\n      id += '-1';\n    } else if (payload.day_evening === 'вечерний') {\n      id += '-2';\n    }\n    payload.id = id;\n  }\n  return payload;\n};"
        },
        "position_x": "19",
        "position_y": "1",
        "reject": null,
        "resolve": null,
        "type": "exec",
        "user_created": "f8f3600f-6504-4e7f-b3d2-5a25fb4ba3a0"
      }
    ],
